<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/theme"
    android:padding="16dp"
    tools:context=".MainActivity">

   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:orientation="horizontal">

      <ImageButton
          android:id="@+id/nutback"
          android:layout_width="80dp"
          android:layout_height="80dp"
          android:background="@null"
          android:src="@drawable/nutback"
          android:contentDescription="Nút quay lại"
          app:tint="@color/white"/>

      <View
          android:layout_width="0dp"
          android:layout_height="1dp"
          android:layout_weight="1"/>

      <ImageButton
          android:id="@+id/nutchinhsua"
          android:layout_width="80dp"
          android:layout_height="80dp"
          android:background="@null"
          android:src="@drawable/nutchinhsua"
          android:contentDescription="Nút chỉnh sửa"
          app:tint="@color/white"/>

   </LinearLayout>

   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:orientation="vertical"
       android:gravity="center">


      <de.hdodenhof.circleimageview.CircleImageView
          android:id="@+id/avatar"
          android:layout_width="180dp"
          android:layout_height="180dp"
          android:src="@drawable/img"
          android:layout_gravity="center" />

      <TextView
          android:id="@+id/name"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="18dp"
          android:gravity="center"
          android:padding="8dp"
          android:text="Hoàng Nguyễn Thu Ngân"
          android:textColor="@color/white"
          android:textSize="20sp"
          android:textStyle="bold"
          android:layout_gravity="center"/>

      <TextView
          android:id="@+id/address"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:padding="8dp"
          android:text="Dĩ An, Việt Nam"
          android:textColor="@color/white"
          android:textSize="18sp"
          android:layout_gravity="center"/>
   </LinearLayout>


</RelativeLayout>